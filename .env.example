# Server-only Battle.net application credentials. Both values are required.
NUXT_BATTLENET_CLIENT_ID=
NUXT_BATTLENET_CLIENT_SECRET=

# PostgreSQL connection. DATABASE_URL takes precedence when it is set.
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_NAME=wowz
DATABASE_PASSWORD=wowz
DATABASE_PORT=5432
DATABASE_USER=wowz
